# Market
MARKET_ASSET=btc
MARKET_WINDOW=5m

# Public price sources. Late-entry requires Binance + Coinbase divergence.
PRICE_FEEDS=polymarket,binance,coinbase
PRICE_FEED_PRIORITY=polymarket,binance,coinbase
MAX_PRICE_STALENESS_SECONDS=2.0

# Simulation parity
SIM_DELAY_MS=150
SIM_SETTLEMENT_DELAY_MS=4000
BUY_MAX_RETRIES=30
BUY_RETRY_DELAY_MS=500

# Official polymarket-client credentials (only needed for production adapters)
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_DEPOSIT_WALLET=0x...
